# Variáveis de Ambiente — Agendify
# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o arquivo ".env" com chaves reais.

# -------------------------------------------------------
# Firebase — Credenciais do Projeto Web
# Obtenha em: Firebase Console > Configurações do projeto > Seus aplicativos > Web
# -------------------------------------------------------
FIREBASE_API_KEY=sua_api_key_aqui
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# -------------------------------------------------------
# Ambiente
# Valores possíveis: development | staging | production
# -------------------------------------------------------
APP_ENV=development
